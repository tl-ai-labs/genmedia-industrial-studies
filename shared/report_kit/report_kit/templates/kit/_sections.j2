{% macro report_body(ctx, uid='') %}
{{ overall_summary(ctx, uid) }}
{{ banners(ctx) }}
{{ lane.after_summary(ctx) }}
{{ task_tables(ctx) }}
{{ families_table(ctx) }}
{{ industries_table(ctx) }}
{{ lane.after_tables(ctx) }}
{{ evidence_section(ctx, uid) }}
{{ lane.after_evidence(ctx) }}
{{ footnotes(ctx, uid) }}
{% endmacro %}
