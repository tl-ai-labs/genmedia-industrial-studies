{% macro banners(ctx) %}
{% if ctx.manifest.state == 'aborted' %}
<div class="banner"><b>Partial run.</b> The budget cap was hit mid-run; only completed cells
are shown. Nothing here pretends to be complete.</div>
{% endif %}
{% if ctx.estimates and not CLIENT %}
<div class="banner"><b>Some costs are estimates</b> (no usage returned by the API):
{{ ctx.estimates|join(', ') }}.</div>
{% endif %}
{% endmacro %}

{% macro duel_strip(ctx, title=None) %}
{% if ctx.duel %}
<div class="duel rev">
  {% if title %}<div class="dt">{{ title }}</div>{% endif %}
  <div class="heads">
    <span class="h a">◆ {{ ctx.duel.a|disp }}{% if ctx.vendors and ctx.vendors.get(ctx.duel.a) %} · {{ ctx.vendors[ctx.duel.a] }}{% endif %}</span>
    {% if CLIENT %}<span class="vsx">vs</span>{% endif %}
    <span class="h b">{{ ctx.duel.b|disp }}{% if ctx.vendors and ctx.vendors.get(ctx.duel.b) %} · {{ ctx.vendors[ctx.duel.b] }}{% endif %} ◆</span>
  </div>
  {% for m in ctx.duel.metrics if not (CLIENT and m.internal_only) %}
  <div class="m">
    <div class="lab">{{ m.client_label if CLIENT else m.label }}</div>
    <div class="pair">
      {% if CLIENT %}<span class="val"><span class="{{ 'wtag' if m.win == 'a' }}">{{ m.a_pct if m.key in ('mean', 'worst') else m.a }}</span></span>
      {% else %}<span class="val">{{ m.a }}{% if m.win == 'a' %} ✦{% endif %}</span>{% endif %}
      <span class="track a {{ 'win' if m.win == 'a' }}"><span class="fill" style="width: {{ m.aw }}%"></span></span>
      <span class="track b {{ 'win' if m.win == 'b' }}"><span class="fill" style="width: {{ m.bw }}%"></span></span>
      {% if CLIENT %}<span class="val r"><span class="{{ 'wtag' if m.win == 'b' }}">{{ m.b_pct if m.key in ('mean', 'worst') else m.b }}</span></span>
      {% else %}<span class="val r">{% if m.win == 'b' %}✦ {% endif %}{{ m.b }}</span>{% endif %}
    </div>
  </div>
  {% endfor %}
</div>
{% endif %}
{% endmacro %}

{% macro overall_summary(ctx) %}
{% set su = ctx.summary %}
{% if su %}
<h2>Overall summary</h2>
{% endif %}
{% endmacro %}

{% macro reliability_note() %}
<ul class="tnote">
  <li><b>Reliability</b> is the model's lowest rating on any single scenario — its worst
  result. Higher is better: it shows how bad an output can get, not just the average.</li>
</ul>
{% endmacro %}

{# one metric value, rendered in its own unit #}
{% macro mcell(v, unit) %}{% if v is none %}<span class="dash">—</span>
{%- elif unit == 'score' %}{{ v|q }}
{%- elif unit == 'ms' %}{{ v|s }}
{%- elif unit == 'usd_micro' %}{{ v|usd }}
{%- elif unit == 'ratio' %}{{ '%.0f%%'|format(v * 100) }}
{%- else %}{{ v }}{% endif %}{% endmacro %}

{# the Gemini-minus-rival difference, always as a percentage:
   score rows in percentage points, everything else relative to the rival #}
{% macro dcell(r) %}{% if r.delta is none %}<span class="dash">—</span>
{%- elif r.unit == 'score' %}{{ r.delta|qd }}
{%- elif r.delta_rel is not none %}{{ '%+.0f%%'|format(r.delta_rel) }}
{%- else %}<span class="dash">—</span>{% endif %}{% endmacro %}

{% macro task_tables(ctx) %}
{% for task, t in ctx.agg.tasks.items() %}
{% set cols = [] %}
{% for mid in (ctx.model_order or t.models.keys()|list|sort) %}
  {% if mid in t.models %}{% set _ = cols.append(mid) %}{% endif %}
{% endfor %}
<h2>{{ task|tasktitle }}{% if not CLIENT %} <span class="tid">{{ task }}</span>{% endif %}</h2>
<div class="tw"><table class="mx">
<thead><tr><th>Metric</th>
{% for mid in cols %}<th class="num{{ ' g' if loop.first }}">{{ mid|disp }}
  {%- if ctx.vendors and ctx.vendors.get(mid) %}<br><span class="vd">{{ ctx.vendors[mid] }}</span>{% endif %}
  {%- if t.models[mid].skipped %}<br><span class="pill">n/a ×{{ t.models[mid].skipped }}</span>{% endif %}</th>{% endfor %}
{% if CLIENT and cols|length == 2 %}<th class="num d">Difference</th>{% endif %}
</tr></thead>
<tbody>
{% for r in t.metric_rows if not (CLIENT and r.internal_only) %}
<tr data-row="{{ r.key }}" class="mrow{{ ' hi' if r.hi }}">
  <td>{{ r.label }}{% if r.better %} <span class="pill">{{ 'higher is better' if r.better == 'higher' else 'lower is better' }}</span>{% endif %}</td>
  {% for c in r.cells %}<td class="num">{{ mcell(c.v, r.unit) }}</td>{% endfor %}
  {% if CLIENT and cols|length == 2 %}
  <td class="num d {{ r.delta_class }}"><span class="dv">{{ dcell(r) }}</span></td>{% endif %}
</tr>
{% endfor %}
</tbody></table></div>
{% if CLIENT and cols|length == 2 %}<p class="tnote">“Difference” is {{ cols[0]|disp }}
compared with {{ cols[1]|disp }}. Green means {{ cols[0]|disp }} is ahead on that row, red
means behind. Ratings differ by percentage points; speed is shown as a relative percentage.</p>{% endif %}

{% if not CLIENT %}{% for p in t.pairs %}{{ verdict_box(p) }}{% endfor %}{% endif %}
{% endfor %}
{% endmacro %}

{% macro verdict_box(p) %}
<div class="verdict">
  <b>{{ p.a|disp }} vs {{ p.b|disp }}:</b>
  {% if p.winner %}<b class="win">{{ p.winner|disp }} wins</b> — {{ p.door_client if CLIENT else p.door }}{% if p.sign_test_p is not none and not CLIENT %}
    (sign test p ≈ {{ p.sign_test_p }}){% endif %}.
  {% else %}{{ p.note_client if CLIENT else p.note }}{% endif %}
  <div class="sub">means {{ p.mean_a|q }} vs {{ p.mean_b|q }} · paired {{ p.wins_a }}–{{ p.ties }}–{{ p.wins_b }}
  over {{ p.n_common }} common scenario(s), {{ p.decided }} decided
  {% if p.sign_test_p is none and p.decided > 0 %} · sign test not quoted (n &lt; 10 decided){% endif %}</div>
</div>
{% endmacro %}

{% macro verdicts_only(ctx) %}
{% for task, t in ctx.agg.tasks.items() %}{% for p in t.pairs %}{{ verdict_box(p) }}{% endfor %}{% endfor %}
{% endmacro %}

{# client breakdown table: one row per family / industry, models as grouped
   columns, the row's leader tagged in green. A row filters the list below. #}
{% macro breakdown_table(ctx, rows, dim, first_label) %}
{% set models = ctx.family_models %}
<div class="tw"><table class="bdt">
<thead>
<tr><th rowspan="2">{{ first_label }}</th><th class="num" rowspan="2">Scenarios</th>
{% for mid in models %}<th class="grp{{ ' a' if loop.first else ' b' }}" colspan="3">{{ mid|disp }}</th>{% endfor %}
</tr>
<tr>{% for mid in models %}<th class="num sep">Quality mean</th><th class="num">Wins</th><th class="num">Win %</th>{% endfor %}</tr>
</thead>
<tbody>
{% for key, f in rows.items()|sort %}
{% set means = [] %}{% set wins = [] %}
{% for mid in models if mid in f.models %}{% set _ = means.append(f.models[mid].mean) %}{% set _ = wins.append(f.models[mid].wins) %}{% endfor %}
{% set top_mean = means|max if means|length == models|length and means|unique|list|length > 1 else none %}
{% set top_wins = wins|max if wins|length == models|length and wins|unique|list|length > 1 else none %}
{% set denom = f.n_both if f.n_both is defined and f.n_both else f.n %}
<tr class="bdrow" data-dim="{{ dim }}" data-val="{{ key }}" title="Show only {{ key }} scenarios">
  <td><span class="bdname">{{ key }}</span></td><td class="num">{{ f.n }}</td>
  {% for mid in models %}{% set m = f.models.get(mid) %}
  {% if m %}
  <td class="num sep">{% if m.mean == top_mean %}<span class="tag lead">{{ m.mean|q }}</span>{% else %}{{ m.mean|q }}{% endif %}</td>
  <td class="num"><span class="tag{{ ' win' if m.wins > 0 }}{{ ' lead' if m.wins == top_wins }}{{ ' zero' if m.wins == 0 }}">{{ m.wins }} {{ 'win' if m.wins == 1 else 'wins' }}</span></td>
  <td class="num{{ ' lead' if m.wins == top_wins }}">{{ '%.0f%%'|format(m.wins / denom * 100) }}</td>
  {% else %}<td class="num sep"><span class="dash">—</span></td><td class="num"><span class="dash">—</span></td><td class="num"><span class="dash">—</span></td>{% endif %}
  {% endfor %}
</tr>
{% endfor %}
</tbody></table></div>
{% endmacro %}

{% macro families_table(ctx) %}
{% if ctx.families and ctx.families|length > 1 %}
<h2>By use-case family</h2>
{% if CLIENT %}
{{ breakdown_table(ctx, ctx.families, 'fam', 'Family') }}
<ul class="tnote">
  <li><b>Quality mean</b> is the average rating across the row's scenarios. <b>Wins</b> are
  scenarios where the model scored higher, by any margin; identical scores are a tie.</li>
  <li><b>Win %</b> is wins out of the scenarios in that row both models completed. Green tags
  mark the row's leader.</li>
  <li>Click a row to show only its scenarios in the list below; click it again to show all.</li>
</ul>
{% else %}
<div class="tw"><table>
<thead><tr><th>Family</th><th class="num">Scenarios</th>
{% for mid in ctx.family_models %}<th class="num">{{ mid|disp }}<br>mean · wins</th>{% endfor %}
</tr></thead>
<tbody>
{% for fam, f in ctx.families.items()|sort %}
<tr><td>{{ fam }}</td><td class="num">{{ f.n }}</td>
{% for mid in ctx.family_models %}
  {% set m = f.models.get(mid) %}
  <td class="num">{% if m %}{{ m.mean|q }} · {{ m.wins }}W{% else %}<span class="dash">—</span>{% endif %}</td>
{% endfor %}
</tr>
{% endfor %}
</tbody></table></div>
<p style="font-size:12.5px;color:var(--muted)">“Wins” = scenarios where the model scored higher
than every other, by any margin; only an identical score is a tie — the same rule as the W–T–L
column and the filter chips.</p>
{% endif %}
{% endif %}
{% endmacro %}

{% macro industries_table(ctx) %}
{% if ctx.industries %}
<h2>By target industry</h2>
{% if CLIENT %}
{{ breakdown_table(ctx, ctx.industries, 'ind', 'Industry (primary)') }}
{% else %}
<div class="tw"><table>
<thead><tr><th>Industry (primary)</th><th class="num">Scenarios</th>
{% for mid in ctx.family_models %}<th class="num">{{ mid|disp }}<br>mean · wins</th>{% endfor %}
</tr></thead>
<tbody>
{% for ind, f in ctx.industries.items()|sort %}
<tr><td>{{ ind }}</td><td class="num">{{ f.n }}</td>
{% for mid in ctx.family_models %}
  {% set m = f.models.get(mid) %}
  <td class="num">{% if m %}{{ m.mean|q }} · {{ m.wins }}W{% else %}<span class="dash">—</span>{% endif %}</td>
{% endfor %}
</tr>
{% endfor %}
</tbody></table></div>
{% endif %}
<p style="font-size:12.5px;color:var(--muted)">Industries come from the sheet's own
“Industry mapping” tab (primary industry per scenario; many scenarios are also relevant
to further industries, per its “also” column).{% if CLIENT %} Click a row to show only its
scenarios below.{% endif %}{% if ctx.hidden_industries %}
Not shown here: {{ ctx.hidden_industries|join(', ') }} — those scenarios are filed under
their next industry from the mapping.{% endif %}{% if ctx.merged_note %}
{{ ctx.merged_note }}{% endif %}</p>
{% endif %}
{% endmacro %}

{% macro evidence_section(ctx, uid, gallery=True) %}
<h2>Per-scenario evidence</h2>
{% if gallery %}
<div class="gallery">
  {% for s in ctx.evidence %}{% set first_thumb = (s.cards | selectattr('mini') | list | first) %}
  {% if first_thumb %}
  <div class="g" data-target="{{ uid }}scn-{{ s.id }}">
    <img src="{{ first_thumb.mini }}" alt="{{ s.id }}" loading="lazy">
    <div class="gid"><span class="dot {{ 'w' if s.winner }}"></span>{{ s.id }}</div>
  </div>
  {% endif %}{% endfor %}
</div>
{% endif %}
<div class="chips">
  {% if ctx.industries %}
  <span class="chip on" data-dim="ind" data-val="__all">All industries</span>
  {% for ind in ctx.industries.keys()|sort %}<span class="chip" data-dim="ind" data-val="{{ ind }}">{{ ind }} <span class="n">({{ ctx.industries[ind].n }})</span></span>{% endfor %}
  {% endif %}
  <span style="flex:1"></span>
  {% set ord = ctx.model_order or ctx.family_models or [] %}
  {% if ord|length >= 2 %}
  <label class="srt">Sort by
    <select data-sort aria-label="Sort scenarios">
      <option value="id">Scenario ID</option>
      <option value="g-desc">{{ ord[0]|disp }} rating — high to low</option>
      <option value="g-asc">{{ ord[0]|disp }} rating — low to high</option>
      <option value="c-desc">{{ ord[1]|disp }} rating — high to low</option>
      <option value="c-asc">{{ ord[1]|disp }} rating — low to high</option>
      <option value="d-desc">Gap, {{ ord[0]|disp }} − {{ ord[1]|disp }} — high to low</option>
      <option value="d-asc">Gap, {{ ord[0]|disp }} − {{ ord[1]|disp }} — low to high</option>
    </select>
  </label>
  {% endif %}
  <button class="ctl" data-act="expand" type="button">Expand all</button>
  <button class="ctl" data-act="collapse" type="button">Collapse all</button>
</div>
<div class="chips">
  <span class="chip on" data-dim="win" data-val="__all">All results</span>
  {% for mid in ctx.family_models %}
    {% set wn = ctx.evidence | selectattr('winner', 'equalto', mid) | list | length %}
    {% if wn %}<span class="chip" data-dim="win" data-val="{{ mid }}">{{ mid|disp }} wins <span class="n">({{ wn }})</span></span>{% endif %}
  {% endfor %}
  {% set tn = ctx.evidence | rejectattr('winner') | list | length %}
  {% if tn %}<span class="chip" data-dim="win" data-val="tie">Ties <span class="n">({{ tn }})</span></span>{% endif %}
</div>
{% if ctx.families and ctx.families|length > 1 %}
<div class="chips">
  <span class="chip on" data-dim="fam" data-val="__all">All families</span>
  {% for fam in ctx.families.keys()|sort %}<span class="chip" data-dim="fam" data-val="{{ fam }}">{{ fam }} <span class="n">({{ ctx.families[fam].n }})</span></span>{% endfor %}
</div>
{% endif %}
<p style="font-size:12.5px;color:var(--muted)">Click a scenario to expand; click an image to
zoom, then flip between models (and the original, for edits) with ←/→.
A scenario is won by the higher score, by any margin{% if not CLIENT %} (compared at two
decimals){% endif %}. Only an identical score is recorded as a tie, and every win count on this
page uses that same rule.</p>

{# the list is wrapped so the sort control can reorder nodes without pushing
   scenarios past the footnotes that follow them #}
<div class="scnlist">
{% for s in ctx.evidence %}
<details class="scn rev" id="{{ uid }}scn-{{ s.id }}" data-fam="{{ s.family }}"
         data-ind="{{ s.industry }}" data-win="{{ s.winner or 'tie' }}"
         data-task="{{ s.task }}" data-i="{{ loop.index0 }}"
         data-g="{{ s.g_score if s.g_score is not none }}"
         data-c="{{ s.c_score if s.c_score is not none }}"
         data-d="{{ s.gap if s.gap is not none }}"{% if loop.first %} open{% endif %}>
  <summary>
    <span class="sid">{{ s.id }}</span>
    <span class="stitle">{{ s.title }}</span>
    {% if s.industry %}<span class="pill" title="also relevant to: {{ s.industry_also|join(', ') or '—' }}">{{ s.industry }}</span>{% endif %}
    {% if s.winner %}<span class="pill ok">winner: {{ s.winner|disp }} ({{ s.margin|qd }})</span>
    {% elif s.margin is not none %}<span class="pill" title="identical score">tie</span>{% endif %}
    <span class="scores">
      {% for c in s.cards %}{% if c.score is not none %}<b class="sc{{ ' win' if s.winner == c.model_id }}" title="{{ c.model_id|disp }}">{{ c.score|q(true) }}</b>{% if not loop.last %} <span class="vs">vs</span> {% endif %}{% endif %}{% endfor %}
    </span>
    <span class="thumbs">
      {% for src in s.sources %}{% if src.mini %}<img class="srcth" src="{{ src.mini }}" alt="original" title="original input"> {% endif %}{% endfor %}
      {% for c in s.cards %}{% if c.mini %}<img src="{{ c.mini }}" alt="">{% endif %}{% endfor %}
    </span>
    <svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
  </summary>
  <div class="body">
    <div class="briefs">
      <div class="brief"><b>Brief (verbatim):</b> {{ s.prompt|trim }}</div>
      <div class="brief"><b>Expected:</b> {{ s.expected|trim }}</div>
    </div>

    <div class="media">
      {% for src in s.sources %}{% if src.thumb %}
      <figure class="shot src">
        <div class="frame">
          <img class="out" src="{{ src.thumb }}" alt="original {{ src.role }}"
               data-sid="{{ s.id }}" data-mid="ORIGINAL ({{ src.role }})"
               data-cap="{{ s.id }} · original input ({{ src.role }}) · sha256 {{ src.sha256[:16] }}…">
        </div>
        <figcaption>
          <span class="who accent">original · {{ src.role }}</span>
          <span class="subcap" title="{{ src.path }}">sha {{ src.sha256[:10] }}…</span>
        </figcaption>
      </figure>
      {% endif %}{% endfor %}
      {% for c in s.cards %}
      <figure class="shot">
        <div class="frame">
          {% if c.thumb %}<img class="out" src="{{ c.thumb }}" alt="{{ c.model_id|disp }} output"
               data-sid="{{ s.id }}" data-mid="{{ c.model_id|disp }}"
               data-cap="{{ s.id }} · {{ c.model_id|disp }}">{% endif %}
          {% if c.score is not none %}
            <span class="badge {{ 'win' if s.winner == c.model_id }}">{{ c.score|q(true) }}</span>
          {% elif c.state == 'skipped' %}<span class="badge">n/a</span>
          {% else %}<span class="badge bad">{{ c.status }}</span>{% endif %}
        </div>
        <figcaption>
          <span class="who">{{ c.model_id|disp }}</span>
          <span class="subcap">{% if c.blind_label and not CLIENT %}blind {{ c.blind_label }}{% endif %}{% if c.gen_cost_micro is not none and not CLIENT %} · {{ c.gen_cost_micro|usd }}{% if c.cost_estimated %} est{% endif %}{% endif %}</span>
          {% if c.latency_ms is not none %}<span class="lat" title="time to generate this clip">{{ c.latency_ms|s }}</span>{% endif %}
        </figcaption>
      </figure>
      {% endfor %}
    </div>
    {% if s.sources %}<p style="font-size:12px;color:var(--faint);margin:2px 4px 0">Click any
    image, then flip with the chips or ←/→ — original ↔ edited in place.</p>{% endif %}

    <div class="dgrid">
    {% for c in s.cards %}
      <div class="dcol">
        <div class="mid">{{ c.model_id|disp }}
          {% if c.status == 'invalid' %}<span class="pill bad">invalid — earned 0</span>{% endif %}
        </div>
        {% if c.gates %}
          {% set failed = c.gates | rejectattr('passed') | list %}
          {% if failed %}{% for g in failed %}<span class="pill bad">✗ {{ g.gate }}{% if g.detail %} · {{ g.detail }}{% endif %}</span>{% endfor %}
          {% else %}<span class="pill ok">✓ all gates</span>{% endif %}
          {% if c.measures and c.measures.width %}<span class="pill">{{ c.measures.width }}×{{ c.measures.height }}</span>{% endif %}
          {% if c.measures and c.measures.preservation_phash_distance is defined %}
            <span class="pill {{ 'ok' if c.measures.preservation_phash_distance <= c.measures.preservation_phash_max else 'bad' }}">pHash {{ c.measures.preservation_phash_distance }}/{{ c.measures.preservation_phash_max }}</span>{% endif %}
          {% if c.measures and c.measures.ocr_match is defined %}
            <span class="pill {{ 'ok' if c.measures.ocr_match >= 0.85 else 'est' }}">OCR {{ '%.2f'|format(c.measures.ocr_match) }}</span>{% endif %}
        {% endif %}
        {% if c.reason %}<div class="crit r">{{ c.reason }}</div>{% endif %}
        {% if c.criteria %}
        <div class="crit" style="border-top:0;padding-top:2px">
          {% for name, cs in c.criteria.items() %}
            <div class="row">
              <span class="nm" title="{{ cs.source }}{% if c.weights and c.weights[name] is defined %} · weight {{ '%.2f'|format(c.weights[name]) }}{% endif %}">{{ name }}</span>
              <span class="track"><span class="bar {{ 'lo' if cs.score < 5 else ('md' if cs.score < 7.5 else '') }}"
                    style="width: {{ (cs.score * 10)|round(1) }}%"></span></span>
              <span class="v">{{ cs.score|q(true) }}</span>
            </div>
          {% endfor %}
          {% if c.unmeasured and not CLIENT %}<div class="r"><span class="pill est">unmeasured: {{ c.unmeasured|join(', ') }}</span> weight redistributed</div>{% endif %}
        </div>
        <details class="disc"><summary>Judge reasoning — why these scores</summary>
          <div class="inner crit" style="border-top:0">
          {% for name, cs in c.criteria.items() %}{% if cs.reasoning %}
            <div class="r"><b>{{ name }}</b> <span class="src">{{ cs.source }}{% if c.weights and c.weights[name] is defined %} · w {{ '%.2f'|format(c.weights[name]) }}{% endif %}</span><br>“{{ cs.reasoning }}”</div>
          {% endif %}{% endfor %}
          {% if c.measures and c.measures.ocr_match_per_item is defined %}
            <div class="r"><span class="src">ocr per string</span> —
              {% for item, v in c.measures.ocr_match_per_item.items() %}
                <span class="pill {{ 'ok' if v >= 0.85 else 'bad' }}">{{ item }} {{ '%.2f'|format(v) }}</span>
              {% endfor %}</div>{% endif %}
          {% if c.overall_note %}<div class="r"><b>Judge note:</b> “{{ c.overall_note }}”</div>{% endif %}
          </div>
        </details>
        {% endif %}
        {% if not CLIENT %}
        <details class="disc"><summary>Checks &amp; provenance</summary>
          <div class="inner">
          {% for g in c.gates or [] %}<span class="pill {{ 'ok' if g.passed else 'bad' }}">{{ g.gate }}{% if g.detail %} · {{ g.detail }}{% endif %}</span>{% endfor %}
          {% if c.artifact %}<div class="crit r" style="border-top:0">artefact:
            <code>{{ c.artifact }}</code> · rows keyed <code>{{ s.id }} × {{ c.model_id }}</code>
            in this run folder's JSONL files</div>{% endif %}
          </div>
        </details>
        {% endif %}
      </div>
    {% endfor %}
    </div>
  </div>
</details>
{% endfor %}
</div>
{% endmacro %}

{% macro footnotes(ctx) %}
<div class="foot">
  <b>Footnotes — what was assumed ({{ ctx.manifest.run_id }}).</b><br>
  {% if not CLIENT %}Totals: generation {{ ctx.totals.gen_micro|usd }} · judging {{ ctx.totals.judge_micro|usd }}
  (kept separate; add them yourself if you must).<br>{% endif %}
  {% if CLIENT %}Ratings are a percentage of the 10-point rubric — 100% is a perfect score
  on every weighted criterion. Latency is wall-clock time to generate one output, and cost is
  the provider's own billed generation cost for one image at the settings used here — list
  price at the time of the run, exclusive of tax.<br>{% endif %}
  {% if ctx.vendor_lines %}Models: {{ ctx.vendor_lines|join(' · ') }}.<br>{% endif %}
  {% if ctx.judge_meta %}Judge: {{ ctx.judge_meta.provider_model }}
  (temperature {{ ctx.judge_meta.temperature }}{% if ctx.judge_version and not CLIENT %}, version {{ ctx.judge_version }}{% endif %})
  — same judge, same rubric, blind shuffled labels for every output.<br>{% endif %}
  {% if not CLIENT %}
  Rubric hashes: {% for task, h in ctx.manifest.rubric_hashes.items() %}{{ task }}={{ h[:12] }} {% endfor %}<br>
  {% if ctx.params_unsupported %}Parameters not honoured:
  {{ ctx.params_unsupported|join(' · ') }}.<br>{% endif %}
  {% if ctx.voice_maps %}Voice ids per provider (voices are NOT identical across providers):
  {{ ctx.voice_maps }}.<br>{% endif %}
  {% if ctx.estimates %}Estimated cost figures: {{ ctx.estimates|join(', ') }} — usage not
  returned by the API; assumption recorded in the telemetry row.<br>{% endif %}
  Effective per-scenario weights (incl. redistributed ones) are in manifest.json; every
  number traces to a JSONL row in the run folder. Outputs are immutable — a correction is
  a new run.
  {% else %}
  Every output was generated once, scored blind by the same judge against the same rubric,
  and is shown above exactly as the model returned it. Outputs are immutable — a correction
  is a new run.
  {% endif %}
</div>
{% endmacro %}
