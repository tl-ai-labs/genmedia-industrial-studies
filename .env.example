# Copy to .env (gitignored). Every enabled model's auth_env is checked at
# start-up, before any spend — a missing key rejects the run.
# NEVER put real keys in THIS file — it is committed to git.
# Real keys go in .env ONLY.
GEMINI_API_KEY=
# Gemini 3.8 TTS (voice lane): a Secret Manager RESOURCE NAME, not a key.
# The adapter reads the key from it at start-up with your Google identity.
GEMINI_API_KEY_SECRET=projects/temp-genmedia-study/secrets/gemini-tts-key/versions/latest
OPENAI_API_KEY=
# Phase 2 (voice lane):
ELEVENLABS_API_KEY=
