# runs are dated, immutable artefacts — never committed, in any module
**/runs/*
!**/runs/.gitkeep

# secrets — never committed, at any level
.env

# python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# local ONNX weights for the voice lane's MOS predictor — fetched, never committed
**/models/*.onnx

# repair backups of run files an editor reformatted
*.reformatted.bak

# macOS
.DS_Store

# blind panel: the exported media and the id->model key are generated;
# anyone with the key can decode the live panel, so it never travels with the repo
panel/dist/
panel/private/
