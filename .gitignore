# Run GENERATIONS stay out of git — large, and not worth versioning.
# Run EVIDENCE and REPORTS are committed: a result has to be defensible without
# the images, so records (INDEX.csv, *.jsonl, manifest.json, frozen scenarios)
# and the rendered reports are tracked. inputs/ and outputs/ are not: inputs are
# the shared asset bank (SHAs are in each manifest) and outputs are regenerable.
**/runs/*
!**/runs/.gitkeep
!**/runs/*.html
!**/runs/*/
**/runs/*/inputs/
**/runs/*/outputs/
**/runs/**/*.png
**/runs/**/*.jpg
**/runs/**/*.jpeg
**/runs/**/*.webp
**/runs/**/*.mp4
**/runs/**/*.wav

# secrets — never committed, at any level
.env

# python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# local ONNX weights for the voice lane's MOS predictor — fetched, never committed
**/models/*.onnx

# repair backups of run files an editor reformatted
*.reformatted.bak

# macOS
.DS_Store

# local-only voice notes and generated scenario-bank export — not for commit
voice/OBSERVATIONS.md
voice/scenario-bank-call-centre-microdrama.xlsx

# blind panel: the exported media and the id->model key are generated;
# anyone with the key can decode the live panel, so it never travels with the repo
panel/dist/
panel/private/

# local preview-server config written by the Claude desktop app; machine-specific paths
.claude/launch.json
