# Copy to .env (gitignored). Every enabled model's auth_env is checked at
# start-up, before any spend — a missing key rejects the run.
# NEVER put real keys in THIS file — it is committed to git.
# Real keys go in .env ONLY.

# ElevenLabs — the quality arm. Billed per 1k CHARACTERS SENT, and the
# free-tier character quota is the binding constraint on how often you can
# re-run a scenario, not the dollar cost.
ELEVENLABS_API_KEY=

# Google — used by THREE things: the Gemini TTS arms, the ASR that produces
# the transcript every WER check is measured against, and the blind judge.
# A service-account JSON path (Vertex ADC), plus the project it belongs to.
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=

# OpenAI — only needed if you flip the openai-* arms in configs/models.yaml
# back to `enabled: true`. They ship disabled with the reason recorded.
OPENAI_API_KEY=
