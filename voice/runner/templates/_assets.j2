{% macro css() %}
<script>document.documentElement.classList.add('js');</script>
<style>
:root{
  --paper:#f6f8f8; --card:#ffffff; --ink:#171d20; --muted:#5a686d; --faint:#8a979c;
  --rule:#e1e8e8; --accent:#0c7d6a; --accent-soft:#e3f2ee; --accent-ink:#0a5f51;
  --warn:#96590f; --warn-soft:#fbf0dd; --bad:#b3352a; --bad-soft:#f9e9e7;
  --shadow:0 1px 2px rgba(20,30,30,.05),0 4px 16px rgba(20,30,30,.06);
  --mono:ui-monospace,SFMono-Regular,"SF Mono",Menlo,Consolas,monospace;
  --sans:system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
}
@media (prefers-color-scheme:dark){
  :root{
    --paper:#101617; --card:#171f21; --ink:#e5ecec; --muted:#9fb0b3; --faint:#6f8085;
    --rule:#263235; --accent:#43c0a8; --accent-soft:#12312b; --accent-ink:#67d6c0;
    --warn:#dfa856; --warn-soft:#2c2214; --bad:#e58d82; --bad-soft:#301d1a;
    --shadow:0 1px 2px rgba(0,0,0,.3),0 4px 18px rgba(0,0,0,.25);
  }
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);
  font-size:15.5px;line-height:1.55;-webkit-font-smoothing:antialiased}
.wrap{max-width:1140px;margin:0 auto;padding:0 20px 90px}

.topbar{position:sticky;top:0;z-index:40;background:color-mix(in srgb,var(--paper) 88%,transparent);
  backdrop-filter:blur(10px);border-bottom:1px solid var(--rule)}
.topbar .in{max-width:1140px;margin:0 auto;padding:10px 20px;display:flex;
  align-items:center;gap:18px;flex-wrap:wrap}
.topbar .t{font-weight:700;font-size:14.5px;letter-spacing:-.01em}
.topbar .m{font-family:var(--mono);font-size:11px;color:var(--faint)}
.topbar nav{margin-left:auto;display:flex;gap:4px;flex-wrap:wrap}
.topbar nav a{font-size:12.5px;color:var(--muted);text-decoration:none;
  padding:5px 10px;border-radius:20px;transition:background .15s,color .15s}
.topbar nav a:hover{background:var(--accent-soft);color:var(--accent-ink)}

header.hero{padding:42px 0 8px}
.kicker{font-family:var(--mono);font-size:11px;letter-spacing:.15em;
  text-transform:uppercase;color:var(--accent);margin:0 0 10px}
h1{font-size:clamp(24px,3.6vw,34px);line-height:1.1;letter-spacing:-.02em;margin:0 0 10px;
  text-wrap:balance}
.meta{display:flex;flex-wrap:wrap;gap:6px 20px;font-family:var(--mono);font-size:11px;
  color:var(--faint);text-transform:uppercase;letter-spacing:.04em}
.meta b{color:var(--ink);font-weight:600}

.tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin:24px 0}
.tile{background:var(--card);border:1px solid var(--rule);border-radius:12px;
  padding:14px 16px;box-shadow:var(--shadow)}
.tile .lab{font-family:var(--mono);font-size:10px;letter-spacing:.08em;
  text-transform:uppercase;color:var(--muted)}
.tile .val{font-size:24px;font-weight:700;letter-spacing:-.02em;margin-top:2px;
  font-variant-numeric:tabular-nums}
.tile .sub{font-size:12px;color:var(--faint)}

/* tabs (combined report) */
.tabbar{display:flex;gap:8px;margin:26px 0 6px;border-bottom:2px solid var(--rule);
  flex-wrap:wrap}
.tabbtn{font-family:var(--sans);font-size:14.5px;font-weight:600;color:var(--muted);
  background:none;border:0;border-bottom:3px solid transparent;padding:10px 16px;
  cursor:pointer;margin-bottom:-2px;transition:color .15s,border-color .15s}
.tabbtn:hover{color:var(--accent-ink)}
.tabbtn.on{color:var(--accent-ink);border-bottom-color:var(--accent)}
.tabbtn .cnt{font-family:var(--mono);font-size:11px;color:var(--faint);margin-left:6px}
.runpanel{display:none}
.runpanel.on{display:block}
@media (prefers-reduced-motion:no-preference){
  .runpanel.on{animation:panelin .25s ease}
  @keyframes panelin{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
}

.duel{background:linear-gradient(135deg,var(--accent-soft),var(--card));
  border:1px solid var(--rule);border-radius:14px;
  padding:20px 22px;margin:18px 0;box-shadow:var(--shadow)}
.duel .heads{display:flex;justify-content:space-between;gap:12px;margin-bottom:14px}
.duel .heads .h{font-family:var(--mono);font-size:12.5px;font-weight:700;letter-spacing:.02em}
.duel .heads .h.a{color:var(--accent-ink)}
.duel .heads .h.b{color:var(--warn)}
.duel .dt{font-family:var(--mono);font-size:10px;letter-spacing:.12em;
  text-transform:uppercase;color:var(--muted);text-align:center;margin-bottom:8px}
.duel .m{margin:12px 0}
.duel .lab{font-family:var(--mono);font-size:10px;letter-spacing:.08em;
  text-transform:uppercase;color:var(--muted);text-align:center;margin-bottom:4px}
.duel .pair{display:grid;grid-template-columns:56px 1fr 1fr 56px;gap:8px;align-items:center}
.duel .val{font-family:var(--mono);font-size:12.5px;font-variant-numeric:tabular-nums}
.duel .val.r{text-align:right}
.duel .track{height:8px;border-radius:5px;background:var(--rule);overflow:hidden;position:relative}
.duel .track .fill{position:absolute;top:0;bottom:0;border-radius:5px}
.duel .track.a .fill{right:0;background:var(--accent);opacity:.35}
.duel .track.b .fill{left:0;background:var(--warn);opacity:.35}
.duel .track.win .fill{opacity:1}
/* bars are statically filled; the grow-in is a JS-gated enhancement so any
   viewer without scripts or attribute-selector support still shows values */
@media (prefers-reduced-motion:no-preference){
  html.js:not(.ready) .duel .fill{width:0 !important}
  html.js .duel .fill{transition:width .8s cubic-bezier(.2,.7,.3,1) .2s}
}

.gallery{display:flex;gap:10px;overflow-x:auto;padding:6px 2px 14px;
  scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch}
.gallery::-webkit-scrollbar{height:8px}
.gallery::-webkit-scrollbar-thumb{background:var(--rule);border-radius:4px}
.gallery .g{flex:0 0 auto;scroll-snap-align:start;width:108px;cursor:pointer;
  border:1px solid var(--rule);border-radius:10px;background:var(--card);
  padding:6px;transition:transform .18s ease,border-color .18s ease}
.gallery .g:hover{transform:translateY(-3px);border-color:var(--accent)}
.gallery .g img{width:94px;height:70px;object-fit:cover;border-radius:6px;display:block}
.gallery .g .gid{font-family:var(--mono);font-size:9.5px;color:var(--muted);
  margin-top:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.gallery .g .dot{display:inline-block;width:7px;height:7px;border-radius:50%;
  margin-right:4px;background:var(--faint)}
.gallery .g .dot.w{background:var(--accent)}

@media (prefers-reduced-motion:no-preference){
  .rev{opacity:0;transform:translateY(10px);
    transition:opacity .45s ease,transform .45s ease}
  .rev.vis{opacity:1;transform:none}
}

.ctl{font-size:12px;padding:5px 12px;border-radius:20px;border:1px solid var(--rule);
  background:var(--card);color:var(--muted);cursor:pointer;transition:border-color .15s}
.ctl:hover{border-color:var(--accent);color:var(--accent-ink)}

h2{font-size:20px;margin:46px 0 12px;letter-spacing:-.015em;scroll-margin-top:70px}
.tw{overflow-x:auto;border:1px solid var(--rule);border-radius:12px;background:var(--card);
  margin:14px 0;box-shadow:var(--shadow)}
table{border-collapse:collapse;width:100%;font-size:13.5px}
th,td{padding:10px 13px;text-align:left;border-bottom:1px solid var(--rule);vertical-align:top}
th{background:color-mix(in srgb,var(--card) 60%,var(--paper));font-family:var(--mono);
  font-size:10px;letter-spacing:.07em;text-transform:uppercase;color:var(--muted);white-space:nowrap}
tr:last-child td{border-bottom:0}
td.num,th.num{text-align:right;font-family:var(--mono);font-size:12.5px;
  font-variant-numeric:tabular-nums;white-space:nowrap}
.dash{color:var(--faint)}

.pill{display:inline-block;font-family:var(--mono);font-size:10px;letter-spacing:.04em;
  padding:2px 8px;border-radius:20px;background:color-mix(in srgb,var(--paper) 70%,var(--card));
  color:var(--muted);margin:1px 3px 1px 0;border:1px solid var(--rule)}
.pill.ok{background:var(--accent-soft);color:var(--accent-ink);border-color:transparent}
.pill.bad{background:var(--bad-soft);color:var(--bad);border-color:transparent}
.pill.est{background:var(--warn-soft);color:var(--warn);border-color:transparent}

.banner{border-left:3px solid var(--warn);background:var(--warn-soft);
  padding:11px 15px;border-radius:0 10px 10px 0;margin:14px 0;font-size:14px}
.verdict{background:linear-gradient(135deg,var(--accent-soft),var(--card));
  border:1px solid var(--rule);border-left:4px solid var(--accent);border-radius:12px;
  padding:16px 20px;margin:16px 0;font-size:15px;box-shadow:var(--shadow)}
.verdict b.win{color:var(--accent-ink)}
.verdict .sub{font-size:12.5px;color:var(--muted);margin-top:6px}

.chips{display:flex;flex-wrap:wrap;gap:8px;margin:14px 0 6px;align-items:center}
.chip{font-size:12.5px;padding:6px 14px;border-radius:20px;border:1px solid var(--rule);
  background:var(--card);color:var(--muted);cursor:pointer;user-select:none;
  transition:background .15s,color .15s,border-color .15s}
.chip:hover{border-color:var(--accent)}
.chip .n{opacity:.75}
.chip.zero{opacity:.4}
.chip.on{background:var(--accent);border-color:var(--accent);color:#fff}
@media (prefers-color-scheme:dark){.chip.on{color:#08211c}}

details.scn{background:var(--card);border:1px solid var(--rule);border-radius:14px;
  margin:12px 0;box-shadow:var(--shadow);overflow:hidden;transition:border-color .2s}
details.scn:hover{border-color:color-mix(in srgb,var(--accent) 45%,var(--rule))}
details.scn>summary{list-style:none;cursor:pointer;display:flex;align-items:center;
  gap:14px;padding:13px 18px;flex-wrap:wrap}
details.scn>summary::-webkit-details-marker{display:none}
.scn .sid{font-family:var(--mono);font-size:12px;color:var(--accent-ink);font-weight:600;
  white-space:nowrap}
.scn .stitle{font-weight:600;font-size:14.5px;flex:1 1 200px}
.scn .thumbs{display:flex;gap:6px}
.scn .thumbs img{width:52px;height:52px;object-fit:cover;border-radius:8px;
  border:1px solid var(--rule)}
.scn .thumbs img.srcth{border:2px solid var(--accent)}
.scn .scores{font-family:var(--mono);font-size:12px;color:var(--muted);white-space:nowrap}
.scn .chev{width:22px;height:22px;flex:none;color:var(--faint);transition:transform .25s ease}
details[open].scn .chev{transform:rotate(180deg)}
.scn .body{padding:4px 18px 20px;border-top:1px dashed var(--rule)}
@media (prefers-reduced-motion:no-preference){
  details[open].scn .body{animation:reveal .3s ease}
  @keyframes reveal{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:none}}
}
.briefs{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:10px;margin:12px 0 4px}
.brief{color:var(--muted);font-size:13px;white-space:pre-wrap;
  background:color-mix(in srgb,var(--paper) 70%,var(--card));border-radius:10px;padding:10px 14px}
.brief b{color:var(--ink)}

.media{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:14px;margin:16px 0 6px}
.shot{margin:0}
.shot .frame{position:relative;height:290px;border:1px solid var(--rule);border-radius:12px;
  background:color-mix(in srgb,var(--paper) 55%,var(--card));display:flex;align-items:center;
  justify-content:center;overflow:hidden}
.shot.src .frame{border-style:dashed;border-color:color-mix(in srgb,var(--accent) 60%,var(--rule))}
.shot .frame img{max-width:100%;max-height:100%;object-fit:contain;cursor:zoom-in;
  transition:transform .2s ease}
.shot .frame img:hover{transform:scale(1.015)}
.shot .badge{position:absolute;top:10px;right:10px;font-family:var(--mono);font-size:13px;
  font-weight:700;padding:4px 10px;border-radius:20px;background:color-mix(in srgb,var(--card) 82%,transparent);
  backdrop-filter:blur(4px);border:1px solid var(--rule)}
.shot .badge.win{background:var(--accent);border-color:var(--accent);color:#fff}
@media (prefers-color-scheme:dark){.shot .badge.win{color:#08211c}}
.shot .badge.bad{background:var(--bad-soft);color:var(--bad);border-color:transparent}
.shot figcaption{display:flex;justify-content:space-between;align-items:baseline;gap:8px;
  padding:7px 4px 0;flex-wrap:wrap}
.shot .who{font-family:var(--mono);font-size:11.5px;font-weight:600;word-break:break-all}
.shot .who.accent{color:var(--accent-ink)}
.shot .subcap{font-family:var(--mono);font-size:10.5px;color:var(--faint);white-space:nowrap}

.dgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:14px;margin-top:12px}
.dcol{border:1px solid var(--rule);border-radius:12px;padding:12px 14px;background:var(--paper)}
.dcol .mid{font-family:var(--mono);font-size:11.5px;color:var(--muted);word-break:break-all;
  margin-bottom:8px}
.disc{margin-top:9px;border-top:1px dashed var(--rule);padding-top:8px}
.disc>summary{cursor:pointer;font-size:12px;color:var(--accent-ink);list-style:none;user-select:none}
.disc>summary::-webkit-details-marker{display:none}
.disc>summary::before{content:'▸ ';font-size:10px}
.disc[open]>summary::before{content:'▾ '}
.disc .inner{padding-top:6px}

.crit{font-size:12.5px;margin-top:10px;border-top:1px dashed var(--rule);padding-top:10px}
.crit .row{display:grid;grid-template-columns:112px 1fr 34px;gap:8px;align-items:center;
  margin:5px 0 1px}
.crit .nm{font-weight:600;font-size:11.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.crit .track{height:6px;border-radius:4px;background:var(--rule);overflow:hidden}
.crit .bar{height:100%;border-radius:4px;background:var(--accent)}
.crit .bar.lo{background:var(--bad)}
.crit .bar.md{background:var(--warn)}
@media (prefers-reduced-motion:no-preference){
  html.js details.scn:not([open]) .crit .bar{width:0 !important}
  html.js details[open].scn .crit .bar{transition:width .6s cubic-bezier(.2,.7,.3,1) .12s}
}
.crit .v{font-family:var(--mono);font-size:11.5px;text-align:right;font-variant-numeric:tabular-nums}
.crit .r{color:var(--muted);margin:2px 0 7px;font-size:12px;line-height:1.5}
.crit .src{font-family:var(--mono);font-size:9.5px;color:var(--faint);
  text-transform:uppercase;letter-spacing:.05em}

#lb{position:fixed;inset:0;background:rgba(10,14,15,.88);display:none;z-index:100;
  align-items:center;justify-content:center;padding:30px;cursor:zoom-out}
#lb.show{display:flex}
#lb img{max-width:94vw;max-height:88vh;border-radius:10px;box-shadow:0 12px 60px rgba(0,0,0,.5)}
#lb .cap{position:fixed;bottom:14px;left:0;right:0;text-align:center;color:#cfe0dd;
  font-family:var(--mono);font-size:12px}
#lb .sw{position:fixed;top:16px;left:0;right:0;display:flex;gap:8px;
  justify-content:center;flex-wrap:wrap}
#lb .sw .swb{font-family:var(--mono);font-size:11.5px;padding:6px 14px;border-radius:20px;
  border:1px solid #3c4a4a;background:rgba(20,28,28,.8);color:#b9cbc8;cursor:pointer}
#lb .sw .swb.on{background:var(--accent);border-color:var(--accent);color:#06211c}
@media (prefers-reduced-motion:no-preference){
  #lb.show img{animation:pop .18s ease}
  @keyframes pop{from{transform:scale(.96);opacity:.4}to{transform:none;opacity:1}}
}

.foot{margin-top:56px;padding-top:20px;border-top:1px solid var(--rule);
  font-family:var(--mono);font-size:11.5px;line-height:1.8;color:var(--faint)}
a{color:var(--accent-ink)}
</style>
{% endmacro %}

{% macro extra_css() %}
<style>
/* Voice-specific. The image lane shows a gallery and a lightbox; a voice
   lane's evidence is something you LISTEN to, so the equivalent affordance
   is a player sitting next to the transcript it produced. */
.clip{border:1px solid var(--rule);border-radius:10px;background:var(--card);
  padding:12px 14px;margin:10px 0;box-shadow:var(--shadow)}
.clip .top{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:8px}
.clip .who{font-family:var(--mono);font-size:12.5px;font-weight:600}
.clip audio{width:100%;height:34px;margin:4px 0}
.clip .tx{font-size:12.5px;color:var(--muted);line-height:1.55;
  border-left:2px solid var(--rule);padding-left:10px;margin-top:8px}
.gates{display:flex;flex-wrap:wrap;gap:5px;margin-top:8px}
.gate{font-size:11px;padding:2px 7px;border-radius:999px;border:1px solid var(--rule);
  font-family:var(--mono)}
.gate.ok{background:var(--accent-soft);color:var(--accent-ink);border-color:transparent}
.gate.no{background:var(--bad-soft);color:var(--bad);border-color:transparent}
.spread{font-family:var(--mono);font-size:12px}
.floorbar{display:flex;align-items:center;gap:8px;margin:6px 0 2px}
.floorbar .bar{position:relative;height:8px;flex:1;background:var(--rule);border-radius:999px}
.floorbar .noise{position:absolute;inset:0 auto 0 0;background:var(--warn-soft);border-radius:999px}
.floorbar .gapmark{position:absolute;top:-3px;width:2px;height:14px;background:var(--ink)}
tr.gaprow td{border-top:2px solid var(--rule);font-weight:600}
tr.gaprow td:first-child{font-size:12px}
</style>
{% endmacro %}

{% macro filter_css() %}
<style>
/* ── Voice lane surface treatment ──────────────────────────────────────
   The image lane's tokens, unchanged - teal accent, same warn and bad. What
   is added here is SEPARATION. In dark mode --paper (#101617) and --card
   (#171f21) sit ten points apart, which reads as one flat sheet once a page
   is mostly cards; these rules lift the card, deepen the ground behind it,
   and let each model carry its own accent so two columns are tellable apart
   at a glance rather than by reading the label. */
:root, :root[data-theme="dark"]{
  color-scheme: light;
  /* LIGHT ONLY, deliberately. This board is read in daylight, screen-shared
     and pasted into decks, and a dark surface inverts badly in all three.
     Re-declaring the base tokens here rather than editing the shared asset
     keeps the image lane's own file untouched - source order does the work,
     since this macro is emitted after css(). */
  --paper:#f6f8f8; --card:#ffffff; --ink:#171d20; --muted:#5a686d; --faint:#8a979c;
  --rule:#e1e8e8; --accent:#0c7d6a; --accent-soft:#e3f2ee; --accent-ink:#0a5f51;
  --warn:#96590f; --warn-soft:#fbf0dd; --bad:#b3352a; --bad-soft:#f9e9e7;
  --shadow:0 1px 2px rgba(20,30,30,.05),0 4px 16px rgba(20,30,30,.06);
  --lift:#ffffff;
  --ground:#eef2f2;
  --edge:rgba(12,125,106,.14);
  --glow:0 0 0 1px rgba(12,125,106,.10);
}
body{background:var(--ground);color:var(--ink)}

/* ── filters ───────────────────────────────────────────────────────── */
.filters{display:flex;flex-wrap:wrap;gap:10px 26px;margin:22px 0 6px;
  padding:14px 16px;border-radius:12px;background:var(--lift);
  border:1px solid var(--rule);box-shadow:var(--shadow)}
.fgroup{display:flex;align-items:center;flex-wrap:wrap;gap:7px}
.flab{font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--faint);
  margin-right:4px;font-family:var(--mono)}
.chip{font:inherit;font-size:12.5px;padding:5px 12px;border-radius:999px;cursor:pointer;
  border:1px solid var(--rule);background:transparent;color:var(--muted);
  transition:background .15s,border-color .15s,color .15s}
.chip:hover{border-color:var(--accent);color:var(--ink)}
.chip.on{background:var(--accent);border-color:var(--accent);color:#fff;font-weight:600;
  box-shadow:0 1px 6px rgba(12,125,106,.28)}
.chip .cnt{opacity:.66;margin-left:6px;font-size:11px;font-variant-numeric:tabular-nums}

/* ── scenario cards ────────────────────────────────────────────────── */
.scard{border:1px solid var(--rule);border-radius:14px;background:var(--lift);
  padding:18px 20px 16px;margin:16px 0;box-shadow:var(--shadow);
  transition:border-color .15s,transform .15s}
.scard:hover{border-color:var(--edge);transform:translateY(-1px)}
.shead{display:flex;justify-content:space-between;align-items:center;gap:12px;
  flex-wrap:wrap;padding-bottom:12px;border-bottom:1px solid var(--rule)}
.ind{font-size:10.5px;letter-spacing:.07em;text-transform:uppercase;color:var(--accent-ink);
  background:var(--accent-soft);padding:4px 10px;border-radius:999px;font-weight:700}
.sid{font-family:var(--mono);font-size:13.5px;font-weight:600;margin-left:10px;color:var(--ink)}
.wbadge{font-size:12px;font-weight:700;padding:5px 13px;border-radius:999px;white-space:nowrap;
  letter-spacing:.01em}
.wbadge.gemini,.wbadge.other{background:var(--accent);color:#fff;
  box-shadow:0 1px 8px rgba(12,125,106,.3)}
.wbadge.tie,.wbadge.split{background:var(--warn-soft);color:var(--warn);
  border:1px solid rgba(150,89,15,.24)}
.wbadge.none{background:transparent;color:var(--faint);border:1px dashed var(--rule)}

.prompt{margin:14px 0 2px}
.prompt summary{cursor:pointer;font-size:11.5px;color:var(--faint);font-family:var(--mono);
  letter-spacing:.04em;text-transform:uppercase}
.prompt summary:hover{color:var(--accent)}
.prompt .script{font-size:13.5px;line-height:1.68;color:var(--ink);background:var(--ground);
  border-left:3px solid var(--accent);padding:12px 16px;border-radius:0 10px 10px 0;
  margin:10px 0 0}

/* ── side by side ──────────────────────────────────────────────────── */
.vs{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:16px 0 8px}
@media (max-width:760px){.vs{grid-template-columns:1fr}}
.col{position:relative;border:1px solid var(--rule);border-radius:12px;padding:14px 16px;
  background:var(--ground);overflow:hidden}
.col::before{content:"";position:absolute;inset:0 auto 0 0;width:3px;
  background:var(--mac,var(--accent));opacity:.85}
.col.won{border-color:var(--accent);background:var(--accent-soft);box-shadow:var(--glow)}
.cm{font-family:var(--mono);font-size:12.5px;font-weight:700;color:var(--ink);
  display:flex;align-items:center;gap:6px}
.col.won .cm{color:var(--accent-ink)}
.cq{font-size:30px;font-weight:680;letter-spacing:-.025em;margin:6px 0 2px;
  font-variant-numeric:tabular-nums;line-height:1.05}
.cq .dash{font-size:14px;font-weight:400}
.cs{font-size:11.5px;color:var(--faint)}
.col audio{width:100%;height:32px;margin-top:10px;filter:saturate(.85)}
.tick{color:var(--accent);font-size:13px}
.sverdict{font-size:13px;color:var(--muted);margin:12px 0 0;line-height:1.6;
  padding-top:12px;border-top:1px solid var(--rule)}
.sverdict b{color:var(--ink)}

.howto{border:1px solid var(--rule);border-radius:12px;background:var(--lift);
  padding:14px 18px;margin:6px 0 18px;box-shadow:var(--shadow)}
.howto summary{cursor:pointer;font-weight:650;font-size:13.5px;color:var(--accent-ink)}
.howto summary:hover{color:var(--accent)}
.hbody{font-size:13.5px;line-height:1.65;color:var(--muted);margin-top:10px}
.hbody b{color:var(--ink)}
.hbody ol{padding-left:20px;margin:10px 0}
.hbody li{margin:7px 0}
.hbody em{font-style:normal;font-family:var(--mono);font-size:12.5px;color:var(--warn)}
</style>
{% endmacro %}

{% macro js() %}
<script>
(function () {
  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  requestAnimationFrame(function () {
    requestAnimationFrame(function () { document.documentElement.classList.add('ready'); });
  });
  function revealAll(scope) {
    (scope || document).querySelectorAll('.rev').forEach(function (el) { el.classList.add('vis'); });
  }
  if (!reduced && 'IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) {
        if (en.isIntersecting) { en.target.classList.add('vis'); io.unobserve(en.target); }
      });
    }, { rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll('.rev').forEach(function (el) { io.observe(el); });
  } else { revealAll(); }

  var tabbar = document.querySelector('.tabbar');
  if (tabbar) tabbar.addEventListener('click', function (e) {
    var b = e.target.closest('.tabbtn'); if (!b) return;
    tabbar.querySelectorAll('.tabbtn').forEach(function (x) {
      x.classList.remove('on'); x.setAttribute('aria-selected', 'false');
    });
    b.classList.add('on'); b.setAttribute('aria-selected', 'true');
    document.querySelectorAll('.runpanel').forEach(function (p) {
      var on = p.dataset.tab === b.dataset.tab;
      p.classList.toggle('on', on);
      p.hidden = !on;
      if (on) revealAll(p);
    });
    if (history.replaceState) history.replaceState(null, '', '#' + b.dataset.tab);
  });

  // Only one clip audible at a time - two models talking over each other is
  // useless for comparison, which is the entire point of the page.
  document.addEventListener('play', function (e) {
    if (e.target.tagName !== 'AUDIO') return;
    document.querySelectorAll('audio').forEach(function (a) {
      if (a !== e.target) { a.pause(); }
    });
  }, true);

  // Filters. Two independent axes - industry and result - ANDed, so
  // "Gaming" + "Gemini wins" answers the question a seller actually asks.
  var state = {ind: 'all', res: 'all'};
  function applyFilters() {
    var shown = 0;
    document.querySelectorAll('.scard').forEach(function (c) {
      var ok = (state.ind === 'all' || c.dataset.ind === state.ind) &&
               (state.res === 'all' || c.dataset.res === state.res);
      c.hidden = !ok;
      if (ok) shown++;
    });
    var empty = document.querySelector('.nomatch');
    if (empty) empty.hidden = shown > 0;
  }
  document.querySelectorAll('.filters .chip').forEach(function (b) {
    b.addEventListener('click', function () {
      var axis = b.dataset.ind !== undefined ? 'ind' : 'res';
      var attr = axis === 'ind' ? 'ind' : 'res';
      b.parentElement.querySelectorAll('.chip').forEach(function (x) { x.classList.remove('on'); });
      b.classList.add('on');
      state[axis] = b.dataset[attr];
      applyFilters();
    });
  });

  var want = (location.hash || '').replace('#', '');
  if (want) {
    var btn = document.querySelector('.tabbtn[data-tab="' + want + '"]');
    if (btn) btn.click();
  }
})();
</script>
{% endmacro %}
