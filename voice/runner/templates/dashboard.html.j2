{# One clip, rendered inside its own model's column. The model name is NOT
   repeated here - the column it sits in already says it, and a label on every
   row of a two-column comparison is noise. #}
{% macro clip_row(c) %}
  <div class="clip">
    <div class="top">
      {% if c.variant %}<span class="who">{{ c.variant }}</span>{% endif %}
      <span class="dash">{{ c.run_label }}</span>
      {% if c.lead %}<span class="pill">median take</span>{% endif %}
      {% if c.corrections %}<span class="pill corr">corrected</span>{% endif %}
      {% if c.score is not none %}<span class="pill">{{ '%.3f'|format(c.score) }}</span>
      {% elif c.status == 'invalid' %}<span class="pill est">gated</span>
      {% elif c.status == 'unjudged' %}<span class="pill est">unjudged</span>{% endif %}
      {% if c.wer is not none %}<span class="dash">WER {{ '%.4f'|format(c.wer) }}</span>{% endif %}
      {% if c.duration_s %}<span class="dash">{{ '%.1f'|format(c.duration_s) }}s</span>{% endif %}
    </div>
    <audio controls preload="none" src="{{ c.audio_rel }}"></audio>
    <div class="gates">
      {% for g in c.gates %}<span class="gate {{ 'ok' if g.passed else 'no' }}">{{ g.gate }}</span>{% endfor %}
    </div>
    {% if c.transcript %}<div class="tx">{{ c.transcript }}</div>{% endif %}
    {% for x in c.corrections %}
    <div class="was"><b>Corrected</b> {{ x.field }}{% if x.gate %} <code>{{ x.gate }}</code>{% endif %}:
      instrument said <code>{{ x.was }}</code>, now <code>{{ x.now }}</code> — {{ x.reason }}
      <span class="dash">({{ x.reviewer_name }}, {{ x.date }})</span></div>
    {% endfor %}
    {% if c.review_note %}<div class="was dimmed">{{ c.review_note }}.</div>{% endif %}
  </div>
{% endmacro %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>GenMedia voice comparison — {{ n_scenarios }} scenarios</title>
{% import "_assets.j2" as assets %}
{{ assets.css() }}
{{ assets.extra_css() }}
{{ assets.filter_css() }}
</head>
<body>

<div class="topbar"><div class="in">
  <span class="t">GenMedia voice comparison</span>
  <span class="m">{{ n_scenarios }} scenarios · {{ n_clips }} clips · {{ runs|length }} runs</span>
  <nav><a href="#overview">Overview</a></nav>
</div></div>

<div class="wrap">
<header class="hero" id="overview">
  <p class="kicker">quality · cost · latency · reliability — four columns, never one number</p>
  <h1>{{ models|map(attribute='model_id')|join(' vs ') }}</h1>
  <div class="meta">
    <span>scenarios <b>{{ n_scenarios }}</b></span>
    <span>passes <b>{{ max_passes }}</b></span>
    <span>judge <b>{{ judge_model }}</b></span>
    {% for r in served.models %}<span>{{ r.model_id }} served from <b>{{ r.served_from }}</b></span>{% endfor %}
  </div>

  <div class="tiles">
    <div class="tile"><div class="lab">Scenarios</div>
      <div class="val">{{ n_scenarios }}</div>
      <div class="sub">{{ repeated_n }} run more than once</div></div>
    <div class="tile"><div class="lab">Generation cost</div>
      <div class="val">{{ gen_micro|usd }}</div>
      <div class="sub">{{ asr_micro|usd }} of it transcription</div></div>
    <div class="tile"><div class="lab">Judging cost</div>
      <div class="val">{{ judge_micro|usd }}</div>
      <div class="sub">kept separate, always</div></div>
  </div>

  <div class="banner"><b>{{ overall.verdict }}.</b> {{ overall.detail }}</div>

  <div class="filters">
    <div class="fgroup">
      <span class="flab">Industry</span>
      <button class="chip on" data-ind="all">All <span class="cnt">{{ scenarios|length }}</span></button>
      {% for ind, n in industries %}
      <button class="chip" data-ind="{{ ind }}">{{ ind }} <span class="cnt">{{ n }}</span></button>
      {% endfor %}
    </div>
    <div class="fgroup">
      <span class="flab">Result</span>
      <button class="chip on" data-res="all">All</button>
      <button class="chip" data-res="gemini">Gemini wins <span class="cnt">{{ gemini_wins }}</span></button>
      <button class="chip" data-res="other">Other model wins <span class="cnt">{{ other_wins }}</span></button>
      <button class="chip" data-res="tie">No winner <span class="cnt">{{ scenarios|length - gemini_wins - other_wins }}</span></button>
    </div>
  </div>

  <div class="banner"><b>A winner is named when the gap clears {{ win_gap }}.</b> That band is set
  for this study, not derived from the runs. Each model's own run-to-run spread is still measured
  and printed beside every gap — where a gap is smaller than that spread, the card says so, because
  those are the verdicts a re-run can move or invert.</div>

  {% if human.present %}
  <div class="banner human-banner"><b>Human review is on this page, and kept apart.</b>
  {{ human.n_observations }} observation{{ '' if human.n_observations == 1 else 's' }} by {{ human.reviewer_names }}
  on {{ human.n_scenarios_reviewed }} scenario{{ '' if human.n_scenarios_reviewed == 1 else 's' }} ({{ human.date_span }}) —
  in a dashed block on each card and on the Review tab; none enters a score, a gate rate or a winner.
  {% if human.n_corrections %}{{ human.n_corrections }} automated result{{ '' if human.n_corrections == 1 else 's' }} the
  reviewers found wrong {{ 'is' if human.n_corrections == 1 else 'are' }} corrected here, each stamped
  <span class="pill corr">corrected</span> with what the instrument said. <code>--no-review</code> renders the instrument untouched.{% endif %}</div>
  {% endif %}

  {% if uncalibrated %}
  <div class="banner"><b>The judge is uncalibrated.</b> The 2-humans × 5-clips gate has never
  been run, so <code>naturalness</code> and <code>clarity</code> carry no evidence that this
  judge agrees with a human. Every score below is stamped <span class="pill pill-warning">unc</span>.</div>
  {% endif %}
</header>

<div class="tabbar" role="tablist">
  <button class="tabbtn on" type="button" role="tab" aria-selected="true" data-tab="t-scenarios">Scenarios<span class="cnt">{{ scenarios|length }}</span></button>
  <button class="tabbtn" type="button" role="tab" aria-selected="false" data-tab="t-models">Models<span class="cnt">{{ models|length }}</span></button>
  <button class="tabbtn" type="button" role="tab" aria-selected="false" data-tab="t-repeats">Repeats<span class="cnt">{{ repeated_n }} repeated</span></button>
  <button class="tabbtn" type="button" role="tab" aria-selected="false" data-tab="t-runs">Runs<span class="cnt">{{ runs|length }}</span></button>
  <button class="tabbtn" type="button" role="tab" aria-selected="false" data-tab="t-review">Review<span class="cnt">{{ human.n_observations }} · {{ human.n_corrections }} corrected</span></button>
</div>

<!-- ──────────────────────────── SCENARIOS ──────────────────────────── -->
<section class="runpanel on" data-tab="t-scenarios">
  <details class="howto"><summary>How a winner is decided</summary>
  <div class="hbody">
    <p><b>Three conditions, all required.</b> Any one failing means no winner is
    named, and the card says which one.</p>
    <p class="note">The band was <b>0.5</b> until 2026-09-04, then each model's
    own measured run-to-run spread, and is now a flat <b>{{ win_gap }}</b> set for
    this study. The spread is still measured and still shown, so you can see the
    distance between what was decided and what the runs demonstrated.</p>
    <ol>
      <li><b>Both models produced a score.</b> A clip that fails a gate is
      <em>invalid</em>, scored nothing, and never reaches the judge. If either
      side has no score the card reads <em>No score</em> or <em>One arm only</em>.</li>
      <li><b>The gap clears {{ win_gap }}.</b> A flat decision band, set for this
      study. Inside it, the card reads <em>Tie</em>.</li>
      <li><b>The winner's gate record is no worse.</b> A model cannot win on
      quality while clearing fewer gates — that is winning the average by
      skipping the harder half. Otherwise: <em>Split</em>.</li>
    </ol>

    <p><b>What the score is made of</b> — gates first, and only what survives
    them is scored:</p>
    <div class="tw"><table>
      <thead><tr><th>Criterion</th><th class="num">Weight</th><th>Scored by</th></tr></thead>
      <tbody>
        <tr><td>Text accuracy</td><td class="num">30%</td><td>measured — word error rate against the transcript</td></tr>
        <tr><td>Pronunciation</td><td class="num">20%</td><td>blind judge</td></tr>
        <tr><td>Naturalness</td><td class="num">20%</td><td>blind judge <span class="pill pill-warning">unc</span></td></tr>
        <tr><td>Clarity</td><td class="num">15%</td><td>blind judge <span class="pill pill-warning">unc</span></td></tr>
        <tr><td>Audio quality</td><td class="num">15%</td><td>half signal metric, half judge</td></tr>
      </tbody></table></div>
    <p class="note">Styled scenarios add <code>style_adherence</code> at 15% and
    re-weight the rest. <span class="pill pill-warning">unc</span> marks criteria
    whose judge has never been calibrated against human listeners.</p>

    <p><b>The gates that run first</b>, and any one of which invalidates a clip:
    decodes · duration in range · trimmed duration (fits the slot, so silence
    cannot pad it) · no long internal silence · no sustained clipping · loudness
    sane · RMS / peak / noise floor against a mastering spec · word error rate
    under the scenario's maximum · digit-exact readback · no over-long digit run
    · required phrases present · forbidden phrases absent · delivery rate in
    range.</p>

    <p><b>The clips are in the columns.</b> Each model's column leads with its
    <em>median</em> take — never its best, which would flatter it and quietly
    disagree with the mean printed above it — and the rest sit behind the
    toggle underneath, because they are the evidence the spread figure rests
    on. Playing one pauses the others: two models talking over each other is
    useless for comparison, which is the point of the page.</p>

    <p class="note"><b>Models are ranked gate-first</b> on the Models tab —
    quality is only compared inside the set that cleared, so failing more can
    never look like scoring higher.</p>
  </div></details>

  {% for s in scenarios %}
  <article class="scard" data-ind="{{ s.industry }}" data-res="{{ s.result_class }}">
    <div class="shead">
      <div>
        <span class="ind">{{ s.industry }}</span>
        <code class="sid">{{ s.id }}</code>
        <span class="dash">· {{ s.n_passes }} passes</span>
      </div>
      <span class="wbadge {{ s.result_class }}">
        {% if s.winner %}{{ s.winner }} wins{% else %}{{ s.verdict }}{% endif %}
      </span>
    </div>

    <details class="prompt" open><summary>The prompt sent to both models{% if s.scripts|length > 1 %} — {{ s.scripts|length }} variants{% endif %}</summary>
      {% for sc in s.scripts %}
        {% if sc.label %}<div class="vlab"><code>{{ sc.label }}</code>{% if sc.title %} <span class="dash">{{ sc.title }}</span>{% endif %}</div>{% endif %}
        <p class="script">{{ sc.text }}</p>
      {% else %}
        <p class="script none">No frozen script recorded for this scenario.</p>
      {% endfor %}</details>

    <div class="vs">
      {% for m in s.side %}
      <div class="col {{ 'won' if m.is_winner }}" style="--mac:{{ m.accent }}">
        <div class="cm">{{ m.model_id }}{% if m.is_winner %} <span class="tick">✦</span>{% endif %}</div>
        <div class="cq">{% if m.mean is not none %}{{ '%.3f'|format(m.mean) }}
            <span class="dash">/10</span>{% else %}<span class="dash">no score</span>{% endif %}</div>
        <div class="cs">
          <span class="dash">{{ m.n_scored }} of {{ m.n_cells }} scored</span>
          {% if m.worst_wer is not none %}<span class="dash">· worst WER {{ '%.4f'|format(m.worst_wer) }}</span>{% endif %}
        </div>
        <div class="gates">
          {% for g in m.failed %}<span class="gate no">{{ g }}</span>{% else %}<span class="gate ok">all gates passed</span>{% endfor %}
          {% if m.n_corrected %}<span class="pill corr">{{ m.n_corrected }} corrected on review</span>{% endif %}
        </div>
        {% for c in m.clips if c.lead %}{{ clip_row(c) }}{% endfor %}
        {% if m.n_more %}
        <details class="more"><summary>{{ m.n_more }} more clip{{ '' if m.n_more == 1 else 's' }} — every take the numbers above rest on</summary>
          {% for c in m.clips if not c.lead %}{{ clip_row(c) }}{% endfor %}
        </details>
        {% endif %}
      </div>
      {% endfor %}
    </div>

    {% if s.group or s.ttfa or s.throughput %}
    <div class="xtra">
      {% if s.group %}
      <div class="xg"><span class="xl">Set verdict</span>
        {% for g in s.group %}
        <div class="xr"><span class="gate {{ 'ok' if g.passed else 'no' }}">{{ 'pass' if g.passed else ('n/a' if not g.measured else 'fail') }}</span>
          <code>{{ g.model_id }}</code> <span class="dash">{{ g.gate }}</span></div>
        <div class="xd">{{ g.detail }}</div>
        {% endfor %}
      </div>
      {% endif %}
      {% if s.ttfa %}
      <div class="xg"><span class="xl">Time to first audio</span>
        {% for t in s.ttfa %}
        <div class="xr"><code>{{ t.model_id }}</code> <span class="dash">n={{ t.n }}</span>
          <b>p50 {{ t.p50 }} ms</b> <span class="dash">p95 {{ t.p95 }} · {{ t.min }}–{{ t.max }}</span></div>
        {% endfor %}
        <div class="xd">One sample is worthless here — the same model returned 775 ms and
          2616 ms on the same line. This is NOT whole-call latency.</div>
      </div>
      {% endif %}
      {% if s.throughput %}
      <div class="xg"><span class="xl">Throughput</span>
        {% for t in s.throughput %}
        <div class="xr"><code>{{ t.model_id }}</code>
          <span class="dash">n={{ t.n }} clips · {{ t.audio_minutes }} min</span>
          <b>${{ '%.4f'|format(t.cost_per_audio_minute / 1000000) }}/audio-min</b></div>
        {% endfor %}
      </div>
      {% endif %}
    </div>
    {% endif %}
    {% if s.human %}
    <div class="human">
      <div class="hl"><span class="xl">Human review</span>
        <span class="dash">what listeners heard — not part of any number on this card</span></div>
      {% for o in s.human %}
      <div class="ob">
        <div class="obh"><b>{{ o.reviewer_name }}</b> <span class="dash">{{ o.date }}</span>
          {% if o.model_id %}<code>{{ o.model_id }}</code>{% else %}<span class="dash">both models</span>{% endif %}
          {% if o.variant %}<span class="who">{{ o.variant }}</span>{% endif %}
          {% if o.run_label %}<span class="dash">{{ o.run_label }}</span>{% endif %}
          {% if o.preference %}<span class="pill est">prefers {{ o.preference }}</span>{% endif %}</div>
        <p class="obn">{{ o.notes }}</p>
        {% if o.tags %}<div class="obt">{% for t in o.tags %}<span class="pill">{{ t }}</span>{% endfor %}</div>{% endif %}
      </div>
      {% endfor %}
    </div>
    {% endif %}
    <p class="sverdict"><b>{{ s.verdict }}.</b> {{ s.detail }}
      {% if s.stale %}<br><span class="dash">{{ s.stale }} earlier run{{ '' if s.stale == 1 else 's' }}
      of this scenario used a different version of it and {{ 'is' if s.stale == 1 else 'are' }}
      excluded above — a repeat has to be the same script and the same gates.</span>{% endif %}</p>
  </article>
  {% endfor %}
  <p class="note nomatch" hidden>No scenario matches those filters.</p>
</section>

<!-- ────────────────────────────── MODELS ────────────────────────────── -->
<section class="runpanel" data-tab="t-models" hidden>
  {% if duel %}
  <div class="duel rev">
    <div class="dt">head to head · {{ duel.basis }}</div>
    <div class="heads">
      <span class="h a">◆ {{ duel.a }}</span>
      <span class="h b">{{ duel.b }} ◆</span>
    </div>
    {% for m in duel.metrics %}
    <div class="m">
      <div class="lab">{{ m.label }}</div>
      <div class="pair">
        <span class="val">{{ m.a }}{% if m.win == 'a' %} ✦{% endif %}</span>
        <span class="track a {{ 'win' if m.win == 'a' }}"><span class="fill" style="width: {{ m.aw }}%"></span></span>
        <span class="track b {{ 'win' if m.win == 'b' }}"><span class="fill" style="width: {{ m.bw }}%"></span></span>
        <span class="val r">{% if m.win == 'b' %}✦ {% endif %}{{ m.b }}</span>
      </div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  <h2>Per model</h2>
  <div class="tw"><table>
  <thead><tr>
    <th>Model</th><th class="num">Quality</th><th class="num">Gates passed</th>
    <th class="num">Repeat spread</th><th class="num">Worst WER</th>
    <th class="num">Cost / clip</th><th class="num">Latency p50 / p95</th><th class="num">Invalid</th>
  </tr></thead>
  <tbody>
  {% for m in models %}
  <tr>
    <td><span class="dot" style="background:{{ m.accent }}"></span> {{ m.model_id }}</td>
    <td class="num">{% if m.mean is not none %}<b>{{ '%.3f'|format(m.mean) }}</b>
        <span class="dash">({{ m.scored_n }} of {{ m.evaluated_n }})</span>
        {% if uncalibrated %} <span class="pill pill-warning">unc</span>{% endif %}
        {% else %}<span class="dash">—</span>{% endif %}</td>
    <td class="num">{{ '%.0f%%'|format(m.gate_pass_rate * 100) }}</td>
    <td class="num">{% if m.repeat_spread is not none %}±{{ '%.3f'|format(m.repeat_spread) }}
        {% else %}<span class="dash">n/a</span>{% endif %}</td>
    <td class="num">{% if m.worst_wer is not none %}{{ '%.4f'|format(m.worst_wer) }}{% else %}<span class="dash">—</span>{% endif %}</td>
    <td class="num">{{ m.mean_cost|usd }}</td>
    <td class="num">{{ m.p50_latency|s }} <span class="dash">/ {{ m.p95_latency|s }}</span></td>
    <td class="num">{{ m.invalid }}</td>
  </tr>
  {% endfor %}
  </tbody></table></div>

  <p class="note"><b>Ranked on the gate first, quality second.</b> Quality is meaned over the
  cells that were actually scored — the count beside it is the denominator, because 9.7 over one
  clip and 9.7 over eight are not the same claim. A cell that failed its gates is carried in
  <em>Invalid</em> and in the gate rate, never averaged into quality: ten of sixteen cells here
  were gated on <em>timing</em>, and a clean read two seconds too long for an ad slot is the
  wrong length, not bad audio.</p>

  {% if streaming.any %}
  <h2>Streaming — time to first audio</h2>
  {% if streaming.lead %}<div class="banner">{{ streaming.lead|safe }}</div>{% endif %}
  <div class="tw"><table>
  <thead><tr>
    <th>Model</th><th class="num">Streamed clips</th><th class="num">First audio min</th>
    <th class="num">First audio p50</th><th class="num">First audio p95</th>
    <th class="num">Whole-call p50</th><th class="num">Cleared ceiling</th>
  </tr></thead>
  <tbody>
  {% for r in streaming.per_model %}
  <tr>
    <td><span class="dot" style="background:{{ r.accent }}"></span> {{ r.model_id }}</td>
    <td class="num">{{ r.n }}</td>
    <td class="num">{{ r.min }} ms</td>
    <td class="num"><b>{{ r.p50 }} ms</b></td>
    <td class="num">{{ r.p95 }} ms</td>
    <td class="num">{% if r.whole_p50 %}{{ (r.whole_p50 / 1000)|round(1) }}s{% else %}<span class="dash">—</span>{% endif %}</td>
    <td class="num">{{ r.passed }} / {{ r.n }}</td>
  </tr>
  {% endfor %}
  </tbody></table></div>

  <div class="tw"><table>
  <thead><tr><th>Scenario</th><th class="num">Ceiling</th>
    {% for r in streaming.per_scenario[0].rows %}<th class="num">{{ r.model_id }}</th>{% endfor %}
  </tr></thead>
  <tbody>
  {% for s in streaming.per_scenario %}
  <tr>
    <td><code>{{ s.id }}</code></td>
    <td class="num">{% if s.ceiling %}{{ s.ceiling }} ms{% else %}<span class="dash">—</span>{% endif %}</td>
    {% for r in s.rows %}
    <td class="num">{{ r.p50 }} ms{% if not r.pass %} <span class="pill pill-warning">over</span>{% endif %}</td>
    {% endfor %}
  </tr>
  {% endfor %}
  </tbody></table></div>

  <p class="note"><b>This is time to the first audio chunk, not whole-call latency</b> — a
  different quantity by roughly an order of magnitude, shown beside it and never in its place.
  Only scenarios that declared <code>max_ttfa_ms</code> are streamed, so only their clips carry
  a first-audio time; percentiles are over both passes. The ceiling is each scenario's own —
  300&nbsp;ms for the game immersion line, 1000&nbsp;ms for the conversational scenarios. This
  is the HTTP-chunked stream route, not a real-time WebSocket path.</p>
  {% endif %}
</section>

<!-- ───────────────────────────── REPEATS ───────────────────────────── -->
<section class="runpanel" data-tab="t-repeats" hidden>
  <h2>The same script, asked more than once</h2>
  <p class="note">This is the only tab that can tell you whether a gap means anything. A repeat
  is the same <em>script</em> and the same <em>gates</em> — runs of an edited scenario are
  excluded and counted below, because their difference is the size of an edit, not the machine's
  noise.</p>

  {% for s in scenarios %}
  <h3><code>{{ s.id }}</code> <span class="dash">· {{ s.n_passes }} pass{{ '' if s.n_passes == 1 else 'es' }}</span></h3>
  {% if s.rows %}
  <div class="tw"><table>
    <thead><tr><th>Model</th>{% for l in s.labels %}<th class="num">{{ l }}</th>{% endfor %}<th class="num">Own spread</th></tr></thead>
    <tbody>
    {% for r in s.rows %}
    <tr><td>{{ r.model_id }}</td>
      {% for v in r.pass_scores %}<td class="num">{% if v is not none %}{{ '%.3f'|format(v) }}{% else %}<span class="dash">—</span>{% endif %}</td>{% endfor %}
      <td class="num">{% if r.spread is not none %}±{{ '%.3f'|format(r.spread) }}{% else %}<span class="dash">n/a</span>{% endif %}</td></tr>
    {% endfor %}
    {% if s.gap is not none %}
    <tr class="gaprow"><td>Δ {{ duel.a }} − {{ duel.b }}</td>
      {% for g in s.gaps %}<td class="num">{% if g is not none %}{{ '%+.3f'|format(g) }}{% else %}<span class="dash">—</span>{% endif %}</td>{% endfor %}
      <td class="num">{% if s.floor is not none %}noise ±{{ '%.3f'|format(s.floor) }}{% else %}<span class="dash">not measured</span>{% endif %}</td></tr>
    {% endif %}
    </tbody></table></div>
  <div class="banner"><b>{{ s.verdict }}.</b> {{ s.detail }}</div>
  {% else %}
  <p class="note">No scored cell yet — every cell failed its gates, so there is nothing to
  compare. The failed clips and the gates they missed are on the Scenarios tab.</p>
  {% endif %}
  {% if s.stale %}
  <p class="note">{{ s.stale }} earlier run{{ '' if s.stale == 1 else 's' }} of this scenario used
  a <b>different version</b> of it and {{ 'is' if s.stale == 1 else 'are' }} excluded above. A
  repeat has to be the same script and the same gates, or what it measures is our edit rather
  than the model.</p>
  {% endif %}
  {% endfor %}
</section>

<!-- ────────────────────────────── RUNS ─────────────────────────────── -->
<section class="runpanel" data-tab="t-runs" hidden>
  <h2>Every run</h2>
  <div class="tw"><table>
    <thead><tr><th>Run</th><th>Started</th><th>Scenario</th><th class="num">Cells</th>
      <th class="num">Passed</th><th class="num">Cost</th><th>Judge</th><th>Predictor</th><th>Served from</th></tr></thead>
    <tbody>
    {% for r in run_rows %}
    <tr><td><code>{{ r.label }}</code></td><td style="font-size:12px">{{ r.started }}</td>
      <td><code>{{ r.scenario }}</code></td><td class="num">{{ r.cells }}</td>
      <td class="num">{{ r.passed }}</td><td class="num">{{ r.cost|usd }}</td>
      <td style="font-size:12px">{{ r.judge }}</td><td style="font-size:12px">{{ r.predictor }}</td>
      <td style="font-size:12px">{{ r.served }}</td></tr>
    {% endfor %}
    </tbody></table></div>

  {% if served.any %}
  <h2 id="served">Where each model was served from</h2>
  <div class="tw"><table>
    <thead><tr><th>Model</th><th>Served from</th><th>Region</th><th>Note</th><th>Source</th></tr></thead>
    <tbody>
    {% for r in served.models %}
    <tr><td><code>{{ r.model_id }}</code></td><td><b>{{ r.served_from }}</b>{% if not r.consistent %} <span class="pill est">differs between runs</span>{% endif %}</td>
      <td><code>{{ r.region or '—' }}</code></td><td style="font-size:12px;max-width:52ch">{{ r.region_note }}</td>
      <td style="font-size:12px">{{ 'run manifest' if r.source == 'manifest' else ('configs/models.yaml (run predates the field)' if r.source == 'config' else 'not recorded') }}</td></tr>
    {% endfor %}
    {% if served.judge %}
    <tr><td>judge</td><td><b>{{ served.judge.served_from }}</b></td><td><code>{{ served.judge.region or '—' }}</code></td>
      <td style="font-size:12px;max-width:52ch">{{ served.judge.region_note }}</td>
      <td style="font-size:12px">{{ 'run manifest' if served.judge.source == 'manifest' else ('configs/models.yaml' if served.judge.source == 'config' else 'not recorded') }}</td></tr>
    {% endif %}
    {% if served.asr %}
    <tr><td>transcriber</td><td><b>{{ served.asr.served_from }}</b></td><td><code>{{ served.asr.region or '—' }}</code></td>
      <td style="font-size:12px;max-width:52ch">{{ served.asr.region_note }}</td>
      <td style="font-size:12px">{{ 'run manifest' if served.asr.source == 'manifest' else ('configs/models.yaml' if served.asr.source == 'config' else 'not recorded') }}</td></tr>
    {% endif %}
    </tbody></table></div>
  {% endif %}
</section>

<!-- ───────────────────────────── REVIEW ────────────────────────────── -->
<section class="runpanel" data-tab="t-review" hidden>
  <h2>Human review</h2>
  {% if not human.present %}
  <p class="note">No human review has been recorded yet. Listening notes and corrections go in
  <code>review/human-review.yaml</code> beside <code>runs/</code> — schema in
  <code>review/README.md</code> — and both boards pick the file up on the next render.</p>
  {% else %}
  <p class="note"><b>Two records, kept apart.</b> The Scenarios tab is what code and the blind
  judge measured. This tab is what {{ human.reviewer_names }} heard ({{ human.date_span }}). The
  observations are printed on each card in a dashed block; nothing here enters a number anywhere.</p>

  {% if human.corrections %}
  <h3>Automated results corrected after human review — {{ human.corrections|length }}</h3>
  <p class="note">Each row is an instrument result a reviewer found wrong, rewritten to the right
  result on this board, with the original beside it. The <code>.jsonl</code> records on disk are
  unaltered; <code>--no-review</code> renders them as they are.</p>
  <div class="tw"><table>
    <thead><tr><th>Clip</th><th>What</th><th>Instrument said</th><th>Corrected to</th><th>Why</th><th>Who, when</th></tr></thead>
    <tbody>
    {% for x in human.corrections %}
    <tr><td><code>{{ x.scenario_id }}</code><br><span class="dash">{{ x.model_id }} · {{ x.run_label }}</span></td>
      <td>{{ x.field }}{% if x.gate %} <code>{{ x.gate }}</code>{% endif %}</td>
      <td class="num"><code>{{ x.was }}</code></td><td class="num"><code>{{ x.now }}</code></td>
      <td style="font-size:12.5px;max-width:48ch">{{ x.reason }}</td>
      <td style="font-size:12px">{{ x.reviewer_name }}<br>{{ x.date }}</td></tr>
    {% endfor %}
    </tbody></table></div>
  {% endif %}

  <h3>Observations, scenario by scenario — {{ human.n_observations }}</h3>
  {% for s in scenarios if s.human %}
  <div class="human">
    <div class="hl"><code class="sid">{{ s.id }}</code>
      <span class="dash">automated: {% if s.winner %}{{ s.winner }} wins{% else %}{{ s.verdict }}{% endif %}</span></div>
    {% for o in s.human %}
    <div class="ob">
      <div class="obh"><b>{{ o.reviewer_name }}</b> <span class="dash">{{ o.date }}</span>
        {% if o.model_id %}<code>{{ o.model_id }}</code>{% else %}<span class="dash">both models</span>{% endif %}
        {% if o.variant %}<span class="who">{{ o.variant }}</span>{% endif %}
        {% if o.run_label %}<span class="dash">{{ o.run_label }}</span>{% endif %}
        {% if o.preference %}<span class="pill est">prefers {{ o.preference }}</span>{% endif %}</div>
      <p class="obn">{{ o.notes }}</p>
    </div>
    {% endfor %}
  </div>
  {% endfor %}
  {% endif %}
</section>

<h2>Footnotes</h2>
<ul class="notes">
  {% for f in footnotes %}<li>{{ f|safe }}</li>{% endfor %}
</ul>

</div>
{{ assets.js() }}
</body>
</html>
