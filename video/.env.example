# Copy to .env (gitignored) and fill in. Keys load only if the variable is
# not already exported. The Vertex route (Veo, judge) uses no key here —
# it needs Application Default Credentials:
#   gcloud auth application-default login
# on an account with Vertex access to the project named in configs/models.yaml.

# Sora arm (OpenAI Videos API — retired 2026-09-24, see configs/models.yaml)
OPENAI_API_KEY=

# Only needed if a Gemini model is ever run via the API-key route instead of Vertex
GEMINI_API_KEY=

# Seedance arm (ByteDance via BytePlus ModelArk) — create an account at
# console.byteplus.com, enable ModelArk, and paste the API key here.
# ARK_BASE_URL optionally overrides the default ap-southeast endpoint
# (ModelArk-compatible endpoints only).
ARK_API_KEY=
